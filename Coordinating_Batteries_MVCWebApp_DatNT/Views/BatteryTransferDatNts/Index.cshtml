@model IEnumerable<Coordinating_Batteries_Entities_DatNT.Models.BatteryTransferDatNt>

@{
    ViewData["Title"] = "Battery Transfers";
}

<div class="container-fluid py-4">
    <!-- Tiêu đề và nút Tạo mới -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold mb-0">Battery Transfer Management</h2>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> + Create New
        </a>
    </div>

    <!-- Bảng dữ liệu -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped table-bordered mb-0 align-middle text-center">
                    <thead class="table-dark">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.BatteryCode)</th>
                            <th>@Html.DisplayNameFor(model => model.Quantity)</th>
                            <th>@Html.DisplayNameFor(model => model.SoHpercent)</th>
                            <th>@Html.DisplayNameFor(model => model.TransportCost)</th>
                            <th>@Html.DisplayNameFor(model => model.RequestDate)</th>
                            <th>@Html.DisplayNameFor(model => model.CompletedDate)</th>
                            <th>@Html.DisplayNameFor(model => model.Status)</th>
                            <th>@Html.DisplayNameFor(model => model.Note)</th>
                            <th>@Html.DisplayNameFor(model => model.IsActive)</th>
                            <th>From Station</th>
                            <th>To Station</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">
                                    @Html.DisplayFor(modelItem => item.BatteryCode)
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.Quantity)</td>
                                <td>
                                    <span class="badge bg-info text-dark">@Html.DisplayFor(modelItem => item.SoHpercent)%</span>
                                </td>
                                <td class="text-success fw-semibold">
                                    @Html.DisplayFor(modelItem => item.TransportCost)
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.RequestDate)</td>
                                <td>@Html.DisplayFor(modelItem => item.CompletedDate)</td>
                                <td>
                                    <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.Status)</span>
                                </td>
                                <td class="text-truncate" style="max-width: 150px;" title="@item.Note">
                                    @Html.DisplayFor(modelItem => item.Note)
                                </td>
                                <td>
                                    @if (item.IsActive == true)
                                    {
                                        <span class="text-success"><i class="bi bi-check-circle-fill"></i> Yes</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger"><i class="bi bi-x-circle-fill"></i> No</span>
                                    }
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.FromStationDatNt.StationName)</td>
                                <td>@Html.DisplayFor(modelItem => item.ToStationDatNt.StationName)</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.BatteryTransferDatNtid" class="btn btn-outline-primary">Edit</a>
                                        <a asp-action="Details" asp-route-id="@item.BatteryTransferDatNtid" class="btn btn-outline-info">Details</a>
                                        <a asp-action="Delete" asp-route-id="@item.BatteryTransferDatNtid" class="btn btn-outline-danger">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>