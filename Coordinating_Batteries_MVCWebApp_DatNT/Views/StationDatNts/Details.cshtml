@model Coordinating_Batteries_Entities_DatNT.Models.StationDatNt

@{
    ViewData["Title"] = "Station Details";
}

<div class="container-fluid py-4 station-page station-form-page">
    <a asp-action="Index" class="d-inline-block text-decoration-none mb-3">&larr; Back to Stations</a>
    <h2 class="text-primary fw-bold mb-1">Station Details</h2>
    <p class="text-muted mb-4">Location, capacity and operating status.</p>

    <div class="card shadow-sm border-0 station-card">
        <div class="card-body p-4">
            <partial name="_StationSummary" model="Model" />
            <div class="d-flex flex-wrap gap-2 border-top pt-4 mt-2">
                <a asp-action="Edit" asp-route-id="@Model.StationDatNtid" class="btn btn-primary">Edit Station</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to Stations</a>
            </div>
        </div>
    </div>
</div>
