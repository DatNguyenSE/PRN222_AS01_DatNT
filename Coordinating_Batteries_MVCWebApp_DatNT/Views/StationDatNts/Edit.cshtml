@model Coordinating_Batteries_Entities_DatNT.Models.StationDatNt

@{
    ViewData["Title"] = "Edit Station";
}

<div class="container-fluid py-4 station-page station-form-page">
    <a asp-action="Index" class="d-inline-block text-decoration-none mb-3">&larr; Back to Stations</a>
    <h2 class="text-primary fw-bold mb-1">Edit Station</h2>
    <p class="text-muted mb-4">Update the details for @Model.StationName.</p>

    <div class="card shadow-sm border-0 station-card">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.StationDatNtid" method="post">
                <input type="hidden" asp-for="StationDatNtid" />
                <partial name="_StationFields" model="Model" />

                <div class="d-flex flex-wrap gap-2 border-top pt-4 mt-4">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
