@model Coordinating_Batteries_Entities_DatNT.Models.StationDatNt

@{
    ViewData["Title"] = "Delete Station";
}

<div class="container-fluid py-4 station-page station-form-page">
    <a asp-action="Index" class="d-inline-block text-decoration-none mb-3">&larr; Back to Stations</a>
    <h2 class="text-danger fw-bold mb-1">Delete Station</h2>
    <p class="text-muted mb-4">Review the station details before deleting.</p>

    <div class="card shadow-sm border-0 station-card">
        <div class="card-body p-4">
            <div class="alert alert-danger mb-4" role="alert">
                Are you sure you want to delete <strong>@Model.StationName</strong>? This action cannot be undone.
            </div>
            <partial name="_StationSummary" model="Model" />

            <form asp-action="Delete" asp-route-id="@Model.StationDatNtid" method="post" class="border-top pt-4 mt-2">
                <input type="hidden" asp-for="StationDatNtid" />
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-danger">Delete Station</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
