@model Coordinating_Batteries_Entities_DatNT.Models.StationDatNt

<div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
<div class="row g-4">
    <div class="col-12">
        <label asp-for="StationName" class="form-label fw-bold">Station name</label>
        <input asp-for="StationName" class="form-control" />
        <span asp-validation-for="StationName" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Address" class="form-label fw-bold">Address</label>
        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Capacity" class="form-label fw-bold">Capacity</label>
        <input asp-for="Capacity" class="form-control" />
        <span asp-validation-for="Capacity" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Status" class="form-label fw-bold">Status</label>
        <select asp-for="Status" class="form-select">
            <option value="0">Inactive</option>
            <option value="1">Active</option>
            <option value="2">Maintenance</option>
            @if (Model != null && Model.Status != 0 && Model.Status != 1 && Model.Status != 2)
            {
                <option value="@Model.Status">Unknown (@Model.Status)</option>
            }
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="PublishDate" class="form-label fw-bold">Publish date</label>
        <input asp-for="PublishDate" class="form-control" type="datetime-local" />
        <span asp-validation-for="PublishDate" class="text-danger"></span>
    </div>
</div>
